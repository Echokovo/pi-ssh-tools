{
  "name": "pi-ssh-tools",
  "version": "0.2.2",
  "description": "Explicit SSH tools for pi. Toggle /ssh on for a host, then use ssh_read, ssh_write, ssh_edit, and ssh_bash without replacing local tools. Your own ! and !! commands follow the active host; prefix one with local: to keep it local.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "ssh",
    "remote",
    "tailscale",
    "macos",
    "vps",
    "coding-agent"
  ],
  "author": "Can Celik",
  "contributors": [
    "Can Celik",
    "Echokovo"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Echokovo/pi-ssh-tools.git"
  },
  "bugs": {
    "url": "https://github.com/Echokovo/pi-ssh-tools/issues"
  },
  "homepage": "https://github.com/Echokovo/pi-ssh-tools#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ]
}
